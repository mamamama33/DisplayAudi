build esp-idf/esp_phy/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/esp_phy/all
  COMMAND = cd /home/uros/DisplayAudi/build/esp-idf/esp_phy && /snap/cmake/1560/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build esp-idf/esp_phy/install/strip: phony esp-idf/esp_phy/CMakeFiles/install/strip.util

